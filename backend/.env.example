# Environment
# Options: development, demo, production
ENVIRONMENT=development

# Authentication mode:
# - 'demo': Local single-user demo with ephemeral demo tokens
# - 'gateway': Multi-user setup validating user headers from a reverse proxy
AUTH_MODE=demo

# LLM provider API keys
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_token_here

# Active LLM provider: 'google', 'groq', 'openrouter', 'github'
LLM_PROVIDER=google

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database (PostgreSQL + pgvector for persistent vector search and multi-replica scaling)
# Optional: If not provided, Veridocs will run with lightweight in-memory storage for test runs
DATABASE_URL=postgresql://user:password@localhost:5432/veridocs

# Authentication & access control
# Secret key used to sign tokens (HMAC-SHA256)
AUTH_SECRET_KEY=generate_a_random_32_character_secret_key_here
TOKEN_EXPIRE_HOURS=24

# Admin key for maintenance endpoints (e.g. POST /api/admin/cleanup)
ADMIN_API_KEY=your_admin_secret_key_here

# Gateway headers (when AUTH_MODE=gateway)
GATEWAY_USER_HEADER=X-Consumer-Custom-ID
GATEWAY_ROLE_HEADER=X-Consumer-Role
GATEWAY_SHARED_SECRET=your_gateway_shared_secret_here
GATEWAY_SECRET_HEADER=X-Gateway-Secret
ALLOW_UNPROTECTED_GATEWAY_HEADERS=false

# Optional API key
REQUIRE_API_KEY=false
API_KEY=your_optional_api_key_here

# Data retention & cleanup
RETENTION_HOURS=24
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
