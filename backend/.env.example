# LLM Provider Keys
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_token_here

# LLM Provider: 'google', 'groq', 'openrouter', 'github' (default: google)
LLM_PROVIDER=google

# === Production CORS Origins ===
# Comma-separated list of allowed origins. Defaults to localhost:3000, localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
# Production example:
# CORS_ORIGINS=https://veridocs.yourdomain.com,https://api.veridocs.yourdomain.com

# === Authentication & Access Control ===
# Secret key used to sign tamper-proof user session tokens (HMAC-SHA256).
# If not provided, a secure random key is generated in memory on startup.
AUTH_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
# Token validity duration in hours (default: 24)
TOKEN_EXPIRE_HOURS=24

# Optional: Require API key for deployment-level gateway protection
REQUIRE_API_KEY=false
API_KEY=your_optional_gateway_api_key_here

# === Data Lifecycle & Retention ===
# Number of hours to retain uploaded files and session indices before automated cleanup
RETENTION_HOURS=24
AUTO_CLEANUP_ENABLED=true
