# Environment
# Options: development, demo, production
ENVIRONMENT=development

# Authentication mode:
# - 'demo': Local single-user demo with ephemeral demo tokens
# - 'gateway': Multi-user setup validating user headers from a reverse proxy
AUTH_MODE=demo

# LLM Provider Configuration
# No default LLM is forced: Veridocs dynamically auto-detects from whichever key or endpoint you configure.
# Or explicitly set LLM_PROVIDER to: 'openai', 'anthropic', 'deepseek', 'groq', 'google', 'ollama', 'mistral', 'openrouter', 'github', or 'custom'.
# LLM_PROVIDER=auto

# 1. OpenAI (gpt-4o, gpt-4o-mini, o1, o3-mini)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# 2. Anthropic (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 3. DeepSeek (deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# 4. Groq (ultra-fast Llama-3.3-70b)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# 5. Local Ollama (100% private, free, runs on your machine without API keys)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# 6. Google Gemini (gemini-2.5-flash)
GOOGLE_API_KEY=your_google_api_key_here

# 7. Mistral AI (mistral-small, mistral-large)
MISTRAL_API_KEY=your_mistral_api_key_here

# 8. OpenRouter (multi-model hub)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 9. GitHub Models
GITHUB_TOKEN=your_github_token_here

# 10. Custom / Self-Hosted OpenAI-Compatible Endpoint (vLLM, LM Studio, TGI, LocalAI)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=optional_token
# LLM_MODEL=custom-model

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database (PostgreSQL + pgvector for persistent vector search and multi-replica scaling)
# Optional: If not provided, Veridocs will run with lightweight in-memory storage for test runs
DATABASE_URL=postgresql://user:password@localhost:5432/veridocs

# Authentication & access control
# Secret key used to sign tokens (HMAC-SHA256)
AUTH_SECRET_KEY=generate_a_random_32_character_secret_key_here
TOKEN_EXPIRE_HOURS=24

# Admin key for maintenance endpoints (e.g. POST /api/admin/cleanup)
ADMIN_API_KEY=your_admin_secret_key_here

# Gateway headers (when AUTH_MODE=gateway)
GATEWAY_USER_HEADER=X-Consumer-Custom-ID
GATEWAY_ROLE_HEADER=X-Consumer-Role
GATEWAY_SHARED_SECRET=your_gateway_shared_secret_here
GATEWAY_SECRET_HEADER=X-Gateway-Secret
ALLOW_UNPROTECTED_GATEWAY_HEADERS=false

# Optional API key
REQUIRE_API_KEY=false
API_KEY=your_optional_api_key_here

# Data retention & cleanup
RETENTION_HOURS=24
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
