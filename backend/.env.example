# === Deployment Environment ===
# Set to 'development', 'demo', or 'production' (default: development)
ENVIRONMENT=development

# Authentication Mode:
# - 'demo': Local development single-user demo with ephemeral demo tokens (/api/auth/demo-token)
# - 'gateway': Multi-tenant deployment validating identity from trusted upstream gateway headers
AUTH_MODE=demo

# === LLM Provider Keys ===
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_token_here

# LLM Provider: 'google', 'groq', 'openrouter', 'github' (default: google)
LLM_PROVIDER=google

# === CORS Origins ===
# Comma-separated list of allowed origins. Defaults to localhost:3000, localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
# Production example:
# CORS_ORIGINS=https://veridocs.yourdomain.com,https://api.veridocs.yourdomain.com

# === Authentication & Access Control ===
# Secret key used to sign tamper-proof user session tokens (HMAC-SHA256).
# IMPORTANT: In production or gateway mode, this MUST be set and MUST be at least 32 characters long.
# The server will fail to start if this is missing or insecure in production.
AUTH_SECRET_KEY=generate_a_random_32_character_secret_key_for_production_here
TOKEN_EXPIRE_HOURS=24

# Administrative key for server-to-server maintenance and cron jobs (e.g. POST /api/admin/cleanup)
ADMIN_API_KEY=your_admin_secret_key_for_cron_jobs_here

# Gateway headers & authenticity verification (when AUTH_MODE=gateway):
GATEWAY_USER_HEADER=X-Consumer-Custom-ID
GATEWAY_ROLE_HEADER=X-Consumer-Role

# Gateway Shared Secret:
# CRITICAL: If the backend is reachable over the network, an attacker could spoof the gateway
# headers above. Configure GATEWAY_SHARED_SECRET so the backend verifies the incoming request
# came from your reverse proxy / gateway via the X-Gateway-Secret header.
GATEWAY_SHARED_SECRET=your_trusted_gateway_shared_secret_here
GATEWAY_SECRET_HEADER=X-Gateway-Secret

# In production with AUTH_MODE=gateway, startup will fail if GATEWAY_SHARED_SECRET or REQUIRE_API_KEY
# is missing, unless explicitly running inside a private network with ALLOW_UNPROTECTED_GATEWAY_HEADERS=true
ALLOW_UNPROTECTED_GATEWAY_HEADERS=false

# Optional: Require API key for gateway layer verification
REQUIRE_API_KEY=false
API_KEY=your_optional_gateway_api_key_here

# === Data Lifecycle & Retention ===
# Number of hours to retain uploaded files and session indices before automated cleanup
RETENTION_HOURS=24
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
