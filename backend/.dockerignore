# Git and system metadata
.git/
.gitignore
.DS_Store

# Python cache and byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Test caches and coverage data
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.log

# Sensitive environment variables and secrets
.env
.env.*
!.env.example

# Local uploads and databases
uploads/*
!uploads/.gitkeep
data/*
!data/.gitkeep
*.db
*.sqlite
*.pdf
!sample_agreement.pdf
