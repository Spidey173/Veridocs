# ==========================================================
# Veridocs Environment Configuration
# ==========================================================

# 1. LLM Configuration (OpenAI-compatible)
# Leave blank for local vector-search & citation preview only.

# Option A: Hosted OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option B: Local Ollama (Zero cost, private)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Option C: Any OpenAI-compatible provider (e.g. Groq, Together, DeepSeek)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# 2. Public Demo & Abuse Protection
# Rate limits (requests per hour per IP)
RATE_LIMIT_QUERY_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Upload constraints
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_SESSIONS_COUNT=20

# 3. CORS Configuration
# Set to your frontend domain in production (e.g. https://your-veridocs.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000
