# Database (PostgreSQL + pgvector in Docker; defaults to SQLite locally if omitted)
DATABASE_URL=postgresql://veridocs:veridocs@postgres:5432/veridocs
POSTGRES_USER=veridocs
POSTGRES_PASSWORD=veridocs
POSTGRES_DB=veridocs

# Redis Task Queue (falls back to in-process ThreadPoolExecutor when unreachable)
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=veridocs_tasks

# Storage Paths
UPLOAD_DIR=./backend/uploads
DATA_DIR=./backend/data

# Backend Server & CORS
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MAX_FILE_SIZE_MB=25

# Frontend -> Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Document Ingestion & OCR
PARSER_BACKEND=docling
OCR_FALLBACK=true
OCR_TEXT_LAYER_MIN_CHARS=50
OCR_MIN_CONFIDENCE=0.6
LIBREOFFICE_BIN=

# Verification (enable CrossEncoder NLI inference when sentence-transformers model is available)
NLI_ENABLED=false
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Feature Toggles
VISION_ENABLED=false
FLAGS_ENABLED=true

# Universal OpenAI-Compatible LLM Configuration (pick one option)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Optional provider shorthands
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
