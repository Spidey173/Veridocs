# ==========================================================
# Veridocs Environment Configuration
# ==========================================================

# 1. Primary LLM Configuration (OpenAI-compatible)
# Supported providers: Groq, Together, DeepSeek, OpenAI, vLLM, Ollama
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

# Optional: Local Ollama (100% private, zero cost)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Optional: Standard OpenAI
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# 2. Public Demo & Abuse Protection
RATE_LIMIT_QUERY_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Upload constraints
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_SESSIONS_COUNT=20

# 3. CORS Configuration
# Set to your frontend URL in production (e.g. https://veridocs17.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://veridocs17.vercel.app
