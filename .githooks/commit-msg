#!/usr/bin/env bash
# Veridocs Conventional Commit Validator Hook

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "❌ Error: Commit message file not found: $COMMIT_MSG_FILE"
    exit 1
fi

# Extract the subject (first non-comment line)
FIRST_LINE=$(grep -v '^#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# Regex matching: type(scope)?: description
PATTERN="^(feat|fix|test|docs|chore|refactor|perf|build|ci)(\([a-zA-Z0-9_.-]+\))?!?: .+$"

if ! echo "$FIRST_LINE" | grep -Eq "$PATTERN"; then
    echo "================================================================================"
    echo "❌ COMMIT REJECTED: Invalid commit message format."
    echo "================================================================================"
    echo "Your commit header was:"
    echo "  \"$FIRST_LINE\""
    echo ""
    echo "Conventional commit format is required:"
    echo "  <type>(<optional-scope>): <imperative summary>"
    echo ""
    echo "Allowed types:"
    echo "  feat:     New features or capability additions"
    echo "  fix:      Bug fixes and error recoveries"
    echo "  test:     Adding or updating unit/eval tests"
    echo "  docs:     Documentation changes and updates"
    echo "  chore:    Tooling, maintenance, dependency, or repo configs"
    echo "  refactor: Code restructuring without functional behavior changes"
    echo "  perf:     Performance improvements and memory optimizations"
    echo ""
    echo "Always include a short body explaining WHY the change was made."
    echo ""
    echo "Valid Example:"
    echo "  feat(auth): gate demo token endpoint behind ENABLE_DEMO_AUTH"
    echo ""
    echo "  Gate /api/auth/demo-token behind an explicit flag so the route"
    echo "  is not registered in production."
    echo "================================================================================"
    exit 1
fi

exit 0
